# =====================================================
#  Adhaar â€“ The SoulServe  |  Apache Security Config
# =====================================================

# â”€â”€ HTTPS redirect â€” active on Render (live server) â”€â”€â”€â”€â”€â”€â”€â”€â”€
<IfModule mod_rewrite.c>
    RewriteEngine On
    # Render already provides HTTPS via proxy â€” check X-Forwarded-Proto
    # to avoid redirect loop on Render/Heroku style deployments
    RewriteCond %{HTTP:X-Forwarded-Proto} =http
    RewriteCond %{HTTP_HOST} !^localhost
    RewriteCond %{HTTP_HOST} !^127\.0\.0\.1
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# â”€â”€ Prevent directory listing â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
Options -Indexes

# â”€â”€ Block direct access to config files â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
<FilesMatch "\.(sql|log|env|ini|json|lock|md)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# â”€â”€ Block direct access to PHP config files â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
<Files "config.php">
    Order allow,deny
    Deny from all
</Files>
<Files "db.php">
    Order allow,deny
    Deny from all
</Files>
<Files "mail.php">
    Order allow,deny
    Deny from all
</Files>
<Files "upload.php">
    Order allow,deny
    Deny from all
</Files>

# â”€â”€ Protect config/ directory entirely â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^config/ - [F,L]
    RewriteRule ^includes/ - [F,L]
    RewriteRule ^vendor/ - [F,L]
    RewriteRule ^database/ - [F,L]
</IfModule>

# â”€â”€ Security headers â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# â”€â”€ Block PHP execution in uploads folder â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# (also enforced by uploads/.htaccess)
<IfModule mod_rewrite.c>
    RewriteRule ^uploads/.*\.php$ - [F,L]
</IfModule>
